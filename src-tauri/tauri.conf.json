{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Unfck Bandcamp",
  "version": "2.4.0",
  "identifier": "com.unfck.bandcamp",
  "build": {
    "frontendDist": "../public/tauri-shell",
    "devUrl": "http://localhost:3457",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/tauri-prepare-shell.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unfck Bandcamp",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../.next/standalone/**/*",
      "../.next/static/**/*",
      "../public/**/*"
    ],
    "externalBin": ["binaries/node"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/MarcoPoppe/unfck-bandcamp/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwODMyQzkyN0IwNURDNTUKUldSVjNBVjdraXlEOE1aNGpNOVBBZkQ3Vk1qOTl6bDgvYmdWRFhydmlka1pjSWsvcExHVFp2UnkK"
    }
  }
}
