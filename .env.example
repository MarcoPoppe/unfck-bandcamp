# Port for the Next.js server (default 3457)
PORT=3457

# Path to the SQLite database file (relative or absolute)
DATABASE_PATH=./data/unfck.db

# Path to the audio cache directory
AUDIO_CACHE_DIR=./data/audio_cache

# Path to the cookie file (used by Phase 1 onboarding)
COOKIE_FILE=./data/bc_cookies.txt

# yt-dlp binary path (default: yt-dlp on PATH)
YTDLP_PATH=yt-dlp

# Background sync interval in minutes (default 360 = 6 hours)
SYNC_INTERVAL_MIN=360
