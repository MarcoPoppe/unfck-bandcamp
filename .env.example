# Address the docker-compose port mapping binds the container's 3457 to.
# Default 127.0.0.1 keeps the cookie-bearing endpoints loopback-only.
# Override to 0.0.0.0 ONLY behind a trusted reverse proxy that adds auth.
BIND_HOST=127.0.0.1

# Port for the Next.js server (default 3457)
PORT=3457

# Path to the SQLite database file (relative or absolute)
DATABASE_PATH=./data/unfck.db

# Path to the audio cache directory
AUDIO_CACHE_DIR=./data/audio_cache

# Path to the cookie file (used by Phase 1 onboarding)
COOKIE_FILE=./data/bc_cookies.txt

# yt-dlp binary path (default: yt-dlp on PATH)
YTDLP_PATH=yt-dlp

# Background sync interval in minutes (default 360 = 6 hours)
SYNC_INTERVAL_MIN=360

# Maximum bytes the audio cache may consume on disk (default 2 GiB)
# Older files are evicted by atime once this is exceeded.
MAX_AUDIO_CACHE_BYTES=2147483648

# Number of most-recent releases to crawl per followed artist (default 12).
# Increase for label-style artist subdomains with large back-catalogues.
DISCOVERY_RELEASES_PER_ARTIST=12
